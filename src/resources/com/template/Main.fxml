<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Bloom?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane prefHeight="708.0" prefWidth="768.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.template.MainController">
    <children>
      <Pane layoutY="4.0" prefHeight="708.0" prefWidth="965.0" style="-fx-background-color: PURPLE;">
         <children>
             <Button fx:id="btnCadastrar" layoutX="481.0" layoutY="102.0" mnemonicParsing="false" onAction="#btnCadastrarAction" text="Cadastrar" />
            <Button fx:id="btnEditar" layoutX="491.0" layoutY="160.0" mnemonicParsing="false" onAction="#btnEditarAction" text="Editar" />
            <Label layoutX="81.0" layoutY="81.0" text="Nome" />
            <Label layoutX="78.0" layoutY="136.0" text="Gênero" />
            <Label layoutX="29.0" layoutY="172.0" prefHeight="67.0" prefWidth="137.0" text="Data de formação  (DD/MM/AAAA)" textAlignment="CENTER" wrapText="true" />
            <Label layoutX="49.0" layoutY="257.0" text="Cidade de Origem" />
            <TextField fx:id="txtNome" layoutX="153.0" layoutY="77.0" />
            <TextField fx:id="txtGenero" layoutX="153.0" layoutY="133.0" />
            <TextField fx:id="txtDataFormacao" layoutX="153.0" layoutY="193.0" />
            <TextField fx:id="txtCidadeOrigem" layoutX="153.0" layoutY="253.0" />
            <Button fx:id="btnExcluir" layoutX="32.0" layoutY="337.0" mnemonicParsing="false" onAction="#btnExcluirAction" text="Excluir">
               <graphic>
                  <TableView fx:id="tblBandas" onMouseClicked="#carregarCampos" prefHeight="330.0" prefWidth="650.0">
                    <columns>
                      <TableColumn fx:id="colId" prefWidth="75.0" text="id" />
                      <TableColumn fx:id="colNome" prefWidth="187.0" text="nome" />
                        <TableColumn fx:id="colGenero" prefWidth="97.0" text="genero" />
                        <TableColumn fx:id="colDataFormacao" prefWidth="143.0" text="data_formacao" />
                        <TableColumn fx:id="colCidadeOrigem" minWidth="2.0" prefWidth="147.0" text="cidade_origem" />
                    </columns>
                  </TableView>
               </graphic>
            </Button>
            <Button fx:id="btnLimpar" layoutX="488.0" layoutY="227.0" mnemonicParsing="false" onAction="#btnLimparAction" text="Limpar" />
         </children>
         <effect>
            <Bloom threshold="1.0" />
         </effect>
      </Pane>
    </children>
</AnchorPane>
